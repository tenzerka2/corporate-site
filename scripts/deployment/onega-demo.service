[Unit]
Description=Onega portfolio demo for Shvetsov Studio
After=network.target

[Service]
Type=simple
User=shvetsov
Group=shvetsov
WorkingDirectory=/opt/onega/current
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3107
ExecStart=/usr/bin/node /opt/onega/current/server.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/onega

[Install]
WantedBy=multi-user.target
