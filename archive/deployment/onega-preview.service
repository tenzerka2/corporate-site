[Unit]
Description=Onega website preview
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/sites/onega
ExecStart=/usr/bin/node /root/sites/onega/node_modules/next/dist/bin/next start --hostname 0.0.0.0 --port 3106
Restart=on-failure
RestartSec=3
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
